From 38d50f8ca319f32794b3d272b3dfe16d262d4716 Mon Sep 17 00:00:00 2001
From: Crabby <crabby@openclaw.local>
Date: Tue, 13 Oct 2026 18:10:54 +0000
Subject: [PATCH] Fix Kaizen quest generation: pass skill profile
 goal/target/constraints to AI for alignment. Prevents contradictory quests
 (e.g., wake 6:00 vs 6:30) and vague titles. Updates client signature and all
 call sites.

---
 src/kaizen/__main__.py             | 12 +++++++++++-
 src/kaizen/ai/client.py            | 17 +++++++++++++++++
 src/kaizen/bot/bot.py              | 22 ++++++++++++++++++++++
 src/kaizen/core/agent.py           | 20 +++++++++++++++++++-
 src/kaizen/web/routes/dashboard.py | 18 ++++++++++++++++++
 5 files changed, 87 insertions(+), 2 deletions(-)

diff --git a/src/kaizen/__main__.py b/src/kaizen/__main__.py
index dabe0cf..f6ca1a6 100644
--- a/src/kaizen/__main__.py
+++ b/src/kaizen/__main__.py
@@ -58,13 +58,23 @@ async def daily_reset_job() -> None:
             if not player.active_skill:
                 continue
             # Generate new quests for today (overwrites any existing)
-            skill_name = player.active_skill.name
+            skill = player.active_skill
+            skill_name = skill.name
+            # Load profile for alignment
+            from kaizen.db.models import SkillProfile
+            profile = db.query(SkillProfile).filter_by(skill_id=skill.id).first()
+            goal = profile.goal if profile else None
+            target = profile.target if profile else None
+            constraints = profile.constraints if profile else None
             # Run synchronous AI call in thread pool to avoid blocking event loop
             ai_quests = await asyncio.to_thread(
                 ai_client.generate_daily_quests,
                 skill_name=skill_name,
                 player_level=player.level,
                 player_rank=player.rank,
+                goal=goal,
+                target=target,
+                constraints=constraints,
             )
             # Remove old quests for today
             db.query(
